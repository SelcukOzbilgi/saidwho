# Copy to .env.local and fill in. Never commit real values.
# All of these are server-only. Never add a NEXT_PUBLIC_ prefix to any of them.

# Owner keys: used for smoke tests, eval runs and the limited trial path only.
# Visitors bring their own keys in the browser; those are never stored here.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# Spend controls for runs paid with owner keys. Trial runs need both switches on
# and a daily budget of at least 0.30, which is what one trial run sets aside
# before it starts (TRIAL_RESERVE_USD in src/lib/server/investigate-handler.ts).
# The budget covers estimated Nebius and Tavily spend. With Supabase set up
# below, it is counted there and every server instance shares it; without, each
# instance counts it in its own memory, so on Vercel the trial stays off until
# both Supabase variables are set.
LIVE_RUNS_ENABLED=false
TRIAL_RUNS_ENABLED=false
DAILY_BUDGET_USD=0

# Set this to open trial runs only to people who have the code, such as
# hackathon judges. The form then asks for it, and a link ending in
# /#code=<the code> fills it in. The code is checked on the server and never
# sent to the browser. A wrong or missing code uses up one of the visitor's
# hourly runs, so guessing is slow, but that count is per address, so the code
# itself has to be unguessable: at least 20 characters, and only letters,
# digits and - _ . ~ so the link carries it unchanged. Make one with
# `openssl rand -base64 18 | tr '+/' '-_'`. Runs with the right code skip
# TRIAL_RUNS_PER_IP_PER_DAY below; the hourly limit and DAILY_BUDGET_USD still
# apply. Leave it empty to let anyone use the trial. Codes with their own
# number of runs (pnpm trial-code) work only while this is set.
TRIAL_ACCESS_CODE=

# How many runs one visitor (one IP address) may start: any run per hour, and
# trial runs per UTC day. Counted where the budget is. Off Vercel the visitor's
# address can't be trusted, so every visitor shares one count there: a local
# demo with trial runs on gets TRIAL_RUNS_PER_IP_PER_DAY trial runs a day in
# total. Raise it (up to 100) in .env.local to run more.
RUNS_PER_IP_PER_HOUR=10
TRIAL_RUNS_PER_IP_PER_DAY=3

# Where runs are saved, so each one gets a public link (/runs/<id>), and where
# the trial budget and the per-visitor counts above are kept. Leave both empty to
# not save runs. Use the project's secret key (sb_secret_...), which bypasses row
# level security, so it must stay on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
