# Copy to .env.local and fill in. Never commit real values.
# All of these are server-only. Never add a NEXT_PUBLIC_ prefix to any of them.

# Owner keys: used for smoke tests, eval runs and the limited trial path only.
# Visitors bring their own keys in the browser; those are never stored here.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# LangSmith tracing (owner-key runs only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=saidwho

# Spend controls for runs paid with owner keys. Trial runs need both switches on
# and a daily budget above 0. The budget covers estimated Nebius and Tavily spend
# and is counted in server memory, so each server instance keeps its own count.
LIVE_RUNS_ENABLED=false
TRIAL_RUNS_ENABLED=false
DAILY_BUDGET_USD=0
