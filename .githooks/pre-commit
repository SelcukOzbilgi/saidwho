#!/bin/sh
# Block commits that contain secrets. Enabled by `pnpm install` (core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Refusing to commit." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
